{
  "name": "dsh-pi-ai-argon-fix",
  "version": "0.2.0",
  "description": "Gemini 4 Argon thinkingLevel compatibility and readable native reasoning summaries for DSH",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.mjs", "client.js", "cordis.patch.yml", "README.md", "LICENSE", "test/contracts"],
  "scripts": {
    "check": "node --check index.mjs && node --check client.js",
    "test": "node --test test/contracts/*.test.mjs",
    "prepack": "npm run check"
  },
  "engines": {"node": ">=22"},
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anonymousnake/dsh-pi-ai-argon-fix.git"
  },
  "bugs": {"url": "https://github.com/Anonymousnake/dsh-pi-ai-argon-fix/issues"},
  "homepage": "https://github.com/Anonymousnake/dsh-pi-ai-argon-fix#readme",
  "author": "Anonymousnake",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "gemini", "argon", "vertex", "google", "cordis"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-renderer"],
      "external": ["react", "@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "dshTarget": "0.2.0-rc.2"
}
